{
    "compilerOptions": {
      "esModuleInterop": true,
      "forceConsistentCasingInFileNames": true,
      "lib": ["es2020"],
      "module": "node16",
      "moduleResolution": "node16",
      "noImplicitAny": true,
      "outDir": "dist",
      "resolveJsonModule": true,
      "sourceMap": true,
      "strict": true,
      "target": "es2020"
    },
    "exclude": ["node_modules"],
    "include": [
      "artifacts/**/*",
      "artifacts/**/*.json",
      "scripts/**/*",
      "tasks/**/*",
      "test/**/*",
      "typechain/**/*",
      "types/**/*",
      "hardhat.config.ts"
    ]
  }